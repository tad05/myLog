generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextIndex"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int              @id @default(autoincrement())
  email          String           @unique(map: "email") @db.VarChar(255)
  name           String?          @db.VarChar(100)
  createdAt      DateTime?        @default(now()) @map("created_at") @db.DateTime(0)
  projects       Project[]
  readingHistory ReadingHistory[]
  scraps         Scrap[]

  @@map("user")
}

model Project {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  title       String    @db.VarChar(255)
  description String?   @db.Text
  createdAt   DateTime? @default(now()) @map("created_at") @db.DateTime(0)
  thumbnail   String?   @db.VarChar(500)
  fileCount   Int?      @default(0) @map("file_count")
  updatedAt   DateTime? @default(now()) @map("updated_at") @db.DateTime(0)
  files       File[]
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_projects_user")

  @@index([userId], map: "idx_projects_user_id")
  @@map("project")
}

model File {
  id          Int       @id @default(autoincrement())
  projectId   Int       @map("project_id")
  name        String    @db.VarChar(255)
  path        String?   @db.VarChar(500)
  language    String?   @db.VarChar(50)
  rawContent  String?   @db.LongText @map("raw_content")
  createdAt   DateTime? @default(now()) @map("created_at") @db.DateTime(0)
  fileSize    Int?      @map("file_size")
  isDirectory Boolean   @default(false) @map("is_directory")
  parentId    Int?      @map("parent_id")
  blog        Blog[]
  file        File?     @relation("fileTofile", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_file_parent")
  other_file  File[]    @relation("fileTofile")
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_files_project")

  @@index([name], map: "idx_file_name")
  @@index([projectId], map: "idx_files_project_id")
  @@index([projectId], map: "idx_project_id")
  @@index([parentId], map: "fk_file_parent")
  @@fulltext([rawContent], map: "idx_file_code")
  @@map("file")
}

model Blog {
  id             Int              @id @default(autoincrement())
  fileId         Int              @unique @map("file_id")
  title          String?          @db.VarChar(255)
  parsedBlocks   Json?            @map("parsed_blocks")
  createdAt      DateTime?        @default(now()) @map("created_at") @db.DateTime(0)
  slug           String?          @db.VarChar(255)
  updatedAt      DateTime?        @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  searchText     String?          @map("search_text") @db.Text
  file           File             @relation(fields: [fileId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_blogs_file")
  stats          BlogStats?
  readingHistory ReadingHistory[]
  scraps         Scrap[]

  @@index([fileId], map: "idx_blog_file")
  @@index([fileId], map: "idx_blogs_file_id")
  @@fulltext([searchText], map: "idx_blog_search")
  @@map("blog")
}

model BlogStats {
  blogId       Int       @id @map("blog_id")
  viewCount    Int?      @default(0) @map("view_count")
  likeCount    Int?      @default(0) @map("like_count")
  commentCount Int?      @default(0) @map("comment_count")
  scrapCount   Int?      @default(0) @map("scrap_count")
  updatedAt   DateTime?  @default(now()) @map("updated_at") @db.DateTime(0)
  blog         Blog      @relation(fields: [blogId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_blog_stats_blog")

  @@map("blog_stat")
}

model Scrap {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  blogId    Int       @map("blog_id")
  createdAt DateTime? @default(now()) @map("created_at") @db.DateTime(0)
  blog      Blog      @relation(fields: [blogId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_scraps_blog")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_scraps_user")

  @@unique([userId, blogId], map: "uq_scrap_user_blog")
  @@index([blogId], map: "fk_scraps_blog")
  @@map("scrap")
}

model ReadingHistory {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  blogId       Int       @map("blog_id")
  lastReadAt DateTime? @default(now()) @map("last_read_at") @db.DateTime(0)
  blog         Blog      @relation(fields: [blogId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_reading_blog")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_reading_user")

  @@unique([userId, blogId], map: "uq_reading_user_blog")
  @@index([blogId], map: "fk_reading_blog")
  @@index([userId, lastReadAt(sort: Desc)], map: "idx_reading_user")
  @@map("reading_history")
}
